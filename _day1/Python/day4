year = int(input("Enter year: "))

if year % 4 == 0:
    print("Leap year")
else:
    print("Not a leap year")







number = int(input("Enter a number: "))

factorial = 1

for i in range(1, number + 1):
    factorial = factorial * i

print("Factorial =", factorial)