numbers = [10, 25, 5, 40, 15]

smallest = numbers[0]

for number in numbers:
    if number < smallest:
        smallest = number

print("Smallest =", smallest)





numbers = [10, 15, 22, 31, 44, 50]

count = 0

for number in numbers:
    if number % 2 == 0:
        count = count + 1

print("Even numbers =", count)