numbers = [10, 25, 5, 40, 15]

smallest = numbers[0]

for number in numbers:
    if number < smallest:
        smallest = number

print("Smallest =", smallest)





numbers = [10, 15, 22, 31, 44, 50]

count = 0

for number in numbers:
    if number % 2 == 0:
        count = count + 1

print("Even numbers =", count)






secret = 7

while True:
    guess = int(input("Guess the number: "))

    if guess == secret:
        print("Correct!")
        break
    elif guess < secret:
        print("Too small")
    else:
        print("Too large")